# Copy to .env and fill in. The project runs with a deterministic mock model if no key is set.

# --- Option A: OpenAI (paid) ---
# OPENAI_API_KEY=sk-...
# APP_LLM_MODEL=gpt-4o-mini
# APP_EMBED_MODEL=text-embedding-3-small

# --- Option B: Google Gemini (FREE) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
APP_LLM_MODEL=gemini-2.0-flash
APP_EMBED_MODEL=text-embedding-004

# Set to 1 to force the offline mock model even if a key is present (useful for fast, free, reproducible runs)
APP_USE_MOCK=0
